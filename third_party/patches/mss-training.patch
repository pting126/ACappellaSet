+def archive_existing_training_artifacts(results_path: str):
+    """Archive old training artifacts before starting a fresh run."""
+
+    if not results_path:
+        return None
+
+    root = Path(results_path)
+    if not root.exists():
+        return None
+
+    patterns = [
+        "last_*.ckpt",
+        "best_*.ckpt",
+        "model_*_ep_*.ckpt",
+        "wandb_run_id.txt",
+        "wandb_run_name.txt",
+        "metadata_*.pkl",
+    ]
+    candidates = []
+    for pattern in patterns:
+        candidates.extend(p for p in root.glob(pattern) if p.is_file())
+
+    unique_candidates = []
+    seen = set()
+    for path in sorted(candidates):
+        if path not in seen:
+            unique_candidates.append(path)
+            seen.add(path)
+
+    if not unique_candidates:
+        return None
+
+    archive_dir = root / f"archive_{time.strftime('%Y%m%d_%H%M%S')}"
+    suffix = 1
+    while archive_dir.exists():
+        archive_dir = root / f"archive_{time.strftime('%Y%m%d_%H%M%S')}_{suffix:02d}"
+        suffix += 1
+    archive_dir.mkdir(parents=True, exist_ok=False)
+
+    for src in unique_candidates:
+        shutil.move(str(src), str(archive_dir / src.name))
+
+    return archive_dir
+
 
