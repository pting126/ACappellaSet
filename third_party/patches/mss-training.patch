+def _resolve_wandb_run_identity(args: argparse.Namespace,
+                                config: Union[ConfigDict, OmegaConf]) -> Tuple[str, str]:
+    """
+    Resolve a stable wandb run id/name for the current experiment.
+
+    By default, the run identity is persisted inside `args.results_path`, so a
+    later resume from the same results directory continues the same wandb run
+    instead of creating a new one.
+    """
+
+    default_name = gen_wandb_name(args, config)
+    env_run_id = os.environ.get("WANDB_RUN_ID", "").strip()
+    env_run_name = os.environ.get("WANDB_RUN_NAME", "").strip()
+    results_path = getattr(args, "results_path", None)
+
+    if not results_path:
+        run_id = env_run_id or wandb.util.generate_id()
+        run_name = env_run_name or default_name
+        return run_id, run_name
+
+    os.makedirs(results_path, exist_ok=True)
+    run_id_path = os.path.join(results_path, "wandb_run_id.txt")
+    run_name_path = os.path.join(results_path, "wandb_run_name.txt")
+
+    if env_run_id:
+        run_id = env_run_id
+    elif os.path.isfile(run_id_path):
+        with open(run_id_path, "r", encoding="utf-8") as f:
+            run_id = f.read().strip()
+    else:
+        run_id = wandb.util.generate_id()
+
+    if env_run_name:
+        run_name = env_run_name
+    elif os.path.isfile(run_name_path):
+        with open(run_name_path, "r", encoding="utf-8") as f:
+            run_name = f.read().strip()
+    else:
+        run_name = default_name
+
+    with open(run_id_path, "w", encoding="utf-8") as f:
+        f.write(run_id + "\n")
+    with open(run_name_path, "w", encoding="utf-8") as f:
+        f.write(run_name + "\n")
+
+    return run_id, run_name
 
 
