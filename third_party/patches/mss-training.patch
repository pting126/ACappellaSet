+def init_htdemucs_2stem_head_from_checkpoint(
+        model: torch.nn.Module,
+        old_model: dict,
+        mode: str = 'none',
+        old_sources=None,
+        verbose: bool = False) -> None:
+    """Overwrite HTDemucs 2-stem final heads with source-aware checkpoint blocks.
+
+    The target 2-stem configs use source order [nonX, X]. For a 6-stem pt_6s
+    checkpoint, initialize X from the matching old source and nonX as the sum of
+    all other old source heads. For a 2-head vocals checkpoint, initialize both
+    new heads from the old vocals head because both outputs are vocal stems.
+    """
+    if mode in (None, '', 'none'):
+        return
+    if not hasattr(model, 'sources') or len(model.sources) != 2:
+        raise ValueError(f'{mode} head init expects a 2-source HTDemucs model, got {getattr(model, "sources", None)}')
+
+    state = _extract_model_state_dict(old_model)
+    model_state = model.state_dict()
+    required = [
+        'decoder.3.conv_tr.weight', 'decoder.3.conv_tr.bias',
+        'tdecoder.3.conv_tr.weight', 'tdecoder.3.conv_tr.bias',
+    ]
+    for key in required:
+        if key not in state:
+            raise KeyError(f'Missing {key} in checkpoint for {mode} head init')
+
+    target_name = model.sources[1]
+    target_lookup = {'baritone': 'other', 'lead_vocal': 'other'}
+    mapped_target = target_lookup.get(target_name, target_name)
+
+    if mode == 'pt6s':
+        old_sources = list(old_sources or ['vp', 'bass', 'soprano', 'alto', 'tenor', 'other'])
+        if mapped_target not in old_sources:
+            raise ValueError(f'Target {target_name} mapped to {mapped_target}, not present in old sources {old_sources}')
+        target_idx = old_sources.index(mapped_target)
+        non_target_indices = [i for i in range(len(old_sources)) if i != target_idx]
+        mapping_desc = f'non{target_name}=sum({[old_sources[i] for i in non_target_indices]}), {target_name}={mapped_target}'
+    elif mode == 'vocals':
+        old_sources = ['other', 'vocals']
+        target_idx = 1
+        non_target_indices = [1]
+        mapping_desc = f'non{target_name}=vocals, {target_name}=vocals'
+    else:
+        raise ValueError(f'Unknown HTDemucs 2-stem head init mode: {mode}')
+
+    head_specs = [
+        ('decoder.3.conv_tr.weight', 'decoder.3.conv_tr.bias', 4),
+        ('tdecoder.3.conv_tr.weight', 'tdecoder.3.conv_tr.bias', 2),
+    ]
+    for weight_key, bias_key, channels_per_source in head_specs:
+        new_w = model_state[weight_key].clone()
+        old_w = state[weight_key].to(new_w.dtype)
+        new_b = model_state[bias_key].clone()
+        old_b = state[bias_key].to(new_b.dtype)
+
+        if old_w.shape[1] % channels_per_source != 0 or new_w.shape[1] != 2 * channels_per_source:
+            raise ValueError(f'Unexpected {weight_key} shape: new={tuple(new_w.shape)} old={tuple(old_w.shape)}')
+        if target_idx * channels_per_source + channels_per_source > old_w.shape[1]:
+            raise ValueError(f'Checkpoint {weight_key} does not contain source index {target_idx}')
+
+        _sum_source_blocks(new_w, 0, old_w, non_target_indices, channels_per_source)
+        _copy_source_block(new_w, 1, old_w, target_idx, channels_per_source)
+        _sum_bias_source_blocks(new_b, 0, old_b, non_target_indices, channels_per_source)
+        _copy_bias_source_block(new_b, 1, old_b, target_idx, channels_per_source)
+        model_state[weight_key] = new_w
+        model_state[bias_key] = new_b
+
+    model.load_state_dict(model_state)
+    if verbose and (not dist.is_initialized() or dist.get_rank() == 0):
+        print(f'Applied HTDemucs 2-stem head init mode={mode}: {mapping_desc}')
+
