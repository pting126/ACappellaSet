+def _extract_model_state_dict(old_model: dict) -> dict:
+    """Return raw weights from supported checkpoint containers."""
+    if isinstance(old_model, dict):
+        if 'state' in old_model:
+            return old_model['state']
+        if 'state_dict' in old_model:
+            return old_model['state_dict']
+        if 'model_state_dict' in old_model:
+            return old_model['model_state_dict']
+    return old_model
+
+
+def _copy_source_block(dst, dst_source_idx, src, src_source_idx, channels_per_source):
+    dst_slice = slice(dst_source_idx * channels_per_source, (dst_source_idx + 1) * channels_per_source)
+    src_slice = slice(src_source_idx * channels_per_source, (src_source_idx + 1) * channels_per_source)
+    dst[:, dst_slice, ...] = src[:, src_slice, ...]
+
+
+def _sum_source_blocks(dst, dst_source_idx, src, src_source_indices, channels_per_source):
+    dst_slice = slice(dst_source_idx * channels_per_source, (dst_source_idx + 1) * channels_per_source)
+    dst[:, dst_slice, ...] = 0
+    for src_source_idx in src_source_indices:
+        src_slice = slice(src_source_idx * channels_per_source, (src_source_idx + 1) * channels_per_source)
+        dst[:, dst_slice, ...] += src[:, src_slice, ...]
+
+
+def _copy_bias_source_block(dst, dst_source_idx, src, src_source_idx, channels_per_source):
+    dst_slice = slice(dst_source_idx * channels_per_source, (dst_source_idx + 1) * channels_per_source)
+    src_slice = slice(src_source_idx * channels_per_source, (src_source_idx + 1) * channels_per_source)
+    dst[dst_slice] = src[src_slice]
+
+
+def _sum_bias_source_blocks(dst, dst_source_idx, src, src_source_indices, channels_per_source):
+    dst_slice = slice(dst_source_idx * channels_per_source, (dst_source_idx + 1) * channels_per_source)
+    dst[dst_slice] = 0
+    for src_source_idx in src_source_indices:
+        src_slice = slice(src_source_idx * channels_per_source, (src_source_idx + 1) * channels_per_source)
+        dst[dst_slice] += src[src_slice]
+
