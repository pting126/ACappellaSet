+def negative_si_sdr(
+    estimate: torch.Tensor,
+    reference: torch.Tensor,
+    eps: float = 1e-8,
+) -> torch.Tensor:
+    """Return channel-wise negative scale-invariant SDR."""
+    estimate = estimate - estimate.mean(dim=-1, keepdim=True)
+    reference = reference - reference.mean(dim=-1, keepdim=True)
+    projection = (
+        (estimate * reference).sum(dim=-1, keepdim=True)
+        * reference
+        / (reference.square().sum(dim=-1, keepdim=True) + eps)
+    )
+    noise = estimate - projection
+    ratio = (
+        (projection.square().sum(dim=-1) + eps)
+        / (noise.square().sum(dim=-1) + eps)
+    )
+    return -10.0 * torch.log10(ratio + eps)
+
+
+def sisdr_composite_loss(
+    prediction: torch.Tensor,
+    references: torch.Tensor,
+    mixture: torch.Tensor,
+    residual_index: int = 0,
+    target_index: int = 1,
+    residual_weight: float = 0.25,
+    reconstruction_weight: float = 0.10,
+    eps: float = 1e-8,
+) -> tuple[torch.Tensor, dict[str, torch.Tensor]]:
+    """V2-A SI-SDR composite for an explicit residual/target two-source model."""
+    if prediction.ndim != 4 or prediction.shape[1] != 2:
+        raise ValueError(
+            "sisdr_composite requires prediction shaped [batch, 2, channels, time]; "
+            f"received {tuple(prediction.shape)}"
+        )
+    if references.ndim != 4 or references.shape[1] != 2:
+        raise ValueError(
+            "sisdr_composite requires references shaped [batch, 2, channels, time]; "
+            f"received {tuple(references.shape)}"
+        )
+    if mixture is None or mixture.ndim != 3:
+        raise ValueError("sisdr_composite requires mixture shaped [batch, channels, time]")
+    if {residual_index, target_index} != {0, 1}:
+        raise ValueError("residual_index and target_index must be distinct values 0 and 1")
+
+    n = min(prediction.shape[-1], references.shape[-1], mixture.shape[-1])
+    prediction = prediction[..., :n]
+    references = references[..., :n]
+    mixture = mixture[..., :n]
+    est_residual = prediction[:, residual_index]
+    est_target = prediction[:, target_index]
+    ref_target = references[:, target_index]
+    ref_residual = mixture - ref_target
+
+    target_terms = negative_si_sdr(est_target, ref_target, eps).mean(dim=1)
+    residual_terms = negative_si_sdr(est_residual, ref_residual, eps).mean(dim=1)
+    reconstruction_terms = (
+        (est_target + est_residual - mixture).abs().mean(dim=(1, 2))
+        / mixture.abs().mean(dim=(1, 2)).clamp_min(eps)
+    )
+    target_rms_ratio = (
+        est_target.square().mean(dim=(1, 2)).sqrt()
+        / ref_target.square().mean(dim=(1, 2)).sqrt().clamp_min(eps)
+    )
+    residual_rms_ratio = (
+        est_residual.square().mean(dim=(1, 2)).sqrt()
+        / ref_residual.square().mean(dim=(1, 2)).sqrt().clamp_min(eps)
+    )
+    per_example = (
+        target_terms
+        + residual_weight * residual_terms
+        + reconstruction_weight * reconstruction_terms
+    )
+    return per_example.mean(), {
+        "target_neg_si_sdr": target_terms.mean(),
+        "residual_neg_si_sdr": residual_terms.mean(),
+        "reconstruction_l1_normalized": reconstruction_terms.mean(),
+        "target_rms_ratio": target_rms_ratio.mean(),
+        "residual_rms_ratio": residual_rms_ratio.mean(),
+    }
 
 
